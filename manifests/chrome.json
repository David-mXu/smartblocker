{
  "manifest_version": 3,
  "name": "FlowGuard",
  "version": "0.2.0",
  "description": "Local-AI distraction blocker — classifies what you watch, blocks only your bad habits",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowGuard"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "history",
    "offscreen",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
