{
  "manifest_version": 3,
  "name": "Smart Blocker",
  "version": "0.5.0",
  "description": "Local-AI distraction blocker — classifies what you watch, blocks only your bad habits",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartBlocker"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "history",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
