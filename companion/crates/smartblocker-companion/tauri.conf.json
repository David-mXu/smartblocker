{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartBlocker Companion",
  "version": "0.1.0",
  "identifier": "dev.davidxu.smartblocker.companion",
  "build": {
    "frontendDist": "ui-dist",
    "beforeBuildCommand": {
      "script": "npm run build:desktop",
      "cwd": "../../.."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SmartBlocker",
        "width": 900,
        "height": 620,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
