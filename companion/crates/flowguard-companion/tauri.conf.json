{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowGuard Companion",
  "version": "0.1.0",
  "identifier": "dev.davidxu.flowguard.companion",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowGuard Companion",
        "width": 500,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
