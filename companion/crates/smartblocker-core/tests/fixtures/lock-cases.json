        "schedulesUpdatedAt": 900000
      },
      "now": 1000000,
      "maxLockMs": 2592000000,
      "expect": {
        "timerUntil": 1500000,
        "passwordHash": "abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd",
        "passwordTs": 800000,
        "frozenUntil": 2000000,
        "schedules": [{ "id": "ok", "days": [1, 5], "startMinutes": 540, "endMinutes": 1020 }],
        "schedulesUpdatedAt": 900000
      }
    },
    {
      "name": "valid tz pins pass through sanitize intact",
      "raw": { "schedules": [{ "id": "ok", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": -300, "tzName": "America/New_York" }] },
      "now": 1000000,
      "maxLockMs": 2592000000,
      "expect": { "timerUntil": null, "passwordHash": null, "passwordTs": 0, "frozenUntil": null, "schedules": [{ "id": "ok", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": -300, "tzName": "America/New_York" }], "schedulesUpdatedAt": 0 }
    },
    {
      "name": "rules with invalid tz pins are dropped, valid neighbors kept",
      "raw": {
        "schedules": [
          { "id": "too-far", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": 9999 },
          { "id": "float", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": 330.5 },
          { "id": "bad-name", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzName": 42 },
          { "id": "ok", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": 840 }
        ]
      },
      "now": 1000000,
      "maxLockMs": 2592000000,
      "expect": { "timerUntil": null, "passwordHash": null, "passwordTs": 0, "frozenUntil": null, "schedules": [{ "id": "ok", "days": [1], "startMinutes": 540, "endMinutes": 1020, "tzOffsetMinutes": 840 }], "schedulesUpdatedAt": 0 }
    }
  ]
}
